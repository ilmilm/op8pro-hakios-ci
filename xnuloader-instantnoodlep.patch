+static void
+display_dump_block(const char *name, uint64_t base, const uint16_t *offsets, uint64_t count)
+{
+	print("DPU %s base=%x\n", name, base);
+	for (uint64_t i = 0; i < count; i++) {
+		uint64_t address = base + offsets[i];
+		uint32_t value = *(volatile uint32_t *)(uintptr_t)address;
+		print("DPU reg %x = %x\n", address, (uint64_t)value);
+	}
+}
+
+static void
+display_dump_registers(void)
+{
+	static const uint32_t sspp[] = { 0x5000, 0x7000, 0x9000, 0xb000, 0x25000, 0x27000, 0x29000, 0x2b000 };
+	static const uint16_t src[] = { 0x00, 0x08, 0x0c, 0x10, 0x14, 0x18, 0x1c, 0x20, 0x24, 0x28, 0x30, 0x34, 0x38, 0x44, 0x48, 0x160, 0x168, 0x16c, 0x170, 0x174 };
+	static const uint16_t ctl[] = { 0x00, 0x04, 0x08, 0x0c, 0x10, 0x14, 0x24, 0x40, 0x44, 0x48, 0x4c, 0x50, 0x70, 0x74, 0x78, 0x7c, 0x80, 0xa0, 0xa4, 0xa8, 0xac, 0xb0, 0xe8, 0xf4, 0x134 };
+	static const uint16_t lm[] = { 0x00, 0x04 };
+	static const uint16_t pp[] = { 0xa0, 0xac, 0xc8 };
+	static const uint16_t dsc[] = { 0x00, 0x04, 0x08, 0x0c, 0x10, 0x14, 0x18, 0x1c, 0x20, 0x24, 0x28, 0x2c, 0x30, 0x34, 0x38 };
+	static const uint32_t dscctl[] = { 0x82800, 0x82804, 0x82808, 0x8280c, 0x82404, 0x82008, 0x81c0c };
+	uint64_t base = 0x0ae00000;
+	int quiet = screen_quiet;
+	screen_quiet = 1;
+	print("== DPU READ-ONLY SNAPSHOT v1 ==\n");
+	print("GOP base=%x width=%d height=%d stride=%d\n", SCREEN.base, (uint64_t)SCREEN.width, (uint64_t)SCREEN.height, (uint64_t)SCREEN.stride);
+	for (uint64_t i = 0; i < sizeof(sspp) / sizeof(sspp[0]); i++) {
+		display_dump_block("SSPP", base + sspp[i], src, sizeof(src) / sizeof(src[0]));
+	}
+	for (uint64_t i = 0; i < 6; i++) {
+		display_dump_block("CTL", base + 0x2000 + i * 0x200, ctl, sizeof(ctl) / sizeof(ctl[0]));
+		display_dump_block("LM", base + 0x45000 + i * 0x1000, lm, sizeof(lm) / sizeof(lm[0]));
+		display_dump_block("PP", base + 0x71000 + i * 0x800, pp, sizeof(pp) / sizeof(pp[0]));
+	}
+	for (uint64_t i = 0; i < 4; i++) {
+		display_dump_block("DSC", base + 0x81000 + i * 0x400, dsc, sizeof(dsc) / sizeof(dsc[0]));
+	}
+	display_dump_block("DSCCTL", base, dscctl, sizeof(dscctl) / sizeof(dscctl[0]));
+	print("== END DPU SNAPSHOT ==\n");
+	screen_quiet = quiet;
+}
